# Without DATABASE_URL the app keeps tasks in the browser (localStorage)
# and has no login. Copy to .env.local and fill in to use the database.

# Postgres connection string (Neon: the pooled one). Set by the Vercel Neon integration.
DATABASE_URL=

# Random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. http://localhost:3000 or https://zaneta-sigma.vercel.app
BETTER_AUTH_URL=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma separated e-mails allowed to sign in; anyone else is rejected.
ALLOWED_EMAILS=

# Push notifications (Web Push). Generate a pair with `pnpm exec web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional, https: or mailto: URL identifying the sender (defaults to BETTER_AUTH_URL).
VAPID_SUBJECT=

# Secret for /api/cron/reminders; the external cron sends `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
